{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Document Finder",
  "version": "0.3.0",
  "identifier": "com.webworldwide.documentfinder",
  "build": {
    "beforeDevCommand": "node scripts/fetch-pdfium.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-pdfium.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Document Finder",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Find open-access research and package it for AI",
    "longDescription": "Search open-access sources in parallel, download papers and books, extract clean Markdown, and hand it to your AI — as an export pack, a copy-paste corpus, or live over MCP.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
